{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "name": "The Quiet Press Tokens",
  "version": "1.0.0",
  "color": {
    "canvas": {
      "ivory": { "$value": "#faf9f5", "$type": "color" },
      "ivoryAlt": { "$value": "#f0ede4", "$type": "color" },
      "slate": { "$value": "#141413", "$type": "color" },
      "slateAlt": { "$value": "#1c1b19", "$type": "color" },
      "slateSubtle": { "$value": "#2b2a26", "$type": "color" }
    },
    "accent": {
      "sky": { "$value": "#0284c7", "$type": "color" },
      "skyHover": { "$value": "#0369a1", "$type": "color" },
      "skySubtle": { "$value": "rgba(2, 132, 199, 0.12)", "$type": "color" },
      "skyDark": { "$value": "#38bdf8", "$type": "color" },
      "sage": { "$value": "#788c5d", "$type": "color" },
      "blue": { "$value": "#6a9bcc", "$type": "color" },
      "amber": { "$value": "#d4973b", "$type": "color" },
      "crimson": { "$value": "#c2534a", "$type": "color" }
    },
    "neutral": {
      "borderLight": { "$value": "#e8e6dc", "$type": "color" },
      "borderDark": { "$value": "#2e2d2a", "$type": "color" },
      "textMutedLight": { "$value": "#737168", "$type": "color" },
      "textMutedDark": { "$value": "#b0aea5", "$type": "color" }
    }
  },
  "typography": {
    "fontFamily": {
      "serif": {
        "$value": ["Newsreader", "Tiempos Text", "Georgia", "serif"],
        "$type": "fontFamily"
      },
      "sans": {
        "$value": ["Inter", "-apple-system", "BlinkMacSystemFont", "sans-serif"],
        "$type": "fontFamily"
      },
      "mono": {
        "$value": ["JetBrains Mono", "Fira Code", "monospace"],
        "$type": "fontFamily"
      }
    },
    "lineHeight": {
      "prose": { "$value": "1.7", "$type": "lineHeight" },
      "tight": { "$value": "1.2", "$type": "lineHeight" },
      "normal": { "$value": "1.5", "$type": "lineHeight" }
    }
  },
  "radii": {
    "sm": { "$value": "4px", "$type": "dimension" },
    "md": { "$value": "8px", "$type": "dimension" },
    "lg": { "$value": "12px", "$type": "dimension" },
    "xl": { "$value": "16px", "$type": "dimension" },
    "2xl": { "$value": "20px", "$type": "dimension" }
  }
}
